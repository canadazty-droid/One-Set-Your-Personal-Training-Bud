<view class="page">
  <text class="eyebrow">ONE SET</text>
  <view class="title">今天想怎么练？</view>

  <view class="chip-row" aria-label="快速训练建议">
    <button class="chip" bindtap="useSuggestion" data-value="30分钟，练胸和三头">30分钟 · 胸 + 三头</button>
    <button class="chip" bindtap="useSuggestion" data-value="45分钟，全身训练">45分钟 · 全身</button>
    <button class="chip" bindtap="useSuggestion" data-value="按我的计划训练">按我的计划训练</button>
  </view>

  <view class="section">
    <label class="label" for="request">一句话告诉我</label>
    <textarea id="request" class="textarea" value="{{input}}" bindinput="onInput" maxlength="120" placeholder="例如：今天有点累，40分钟，练背和二头" />
    <view wx:if="{{error}}" class="status danger" style="margin-top: 16rpx;">{{error}}</view>
    <button class="primary" style="margin-top: 20rpx;" loading="{{generating}}" disabled="{{generating}}" bindtap="generate">生成今天训练</button>
    <button class="secondary" style="margin-top: 16rpx;" bindtap="goPlans">导入训练计划</button>
  </view>

  <view wx:if="{{workout}}" class="section">
    <view class="row between">
      <view>
        <view class="eyebrow">TODAY'S WORKOUT</view>
        <view class="section-title" style="margin-top: 12rpx;">{{workout.name}}</view>
      </view>
      <view class="metric" style="font-size: 48rpx;">{{workout.durationMinutes}}<text style="font-size: 22rpx;"> MIN</text></view>
    </view>
    <view class="card">
      <block wx:for="{{workout.exercises}}" wx:key="id">
        <view class="row between">
          <view style="flex:1;">
            <view style="font-weight:800;">{{index + 1}}. {{item.name}}</view>
            <view class="muted" style="font-size: 26rpx; margin-top: 8rpx;">{{item.sets}} 组 × {{item.reps}} · 休息 {{item.restSeconds}} 秒</view>
          </view>
        </view>
        <view wx:if="{{index < workout.exercises.length - 1}}" class="divider"></view>
      </block>
    </view>
    <view class="status" style="margin-top: 16rpx;">{{workout.adjustmentReason}}</view>
    <button class="primary" style="margin-top: 20rpx;" bindtap="startWorkout">开始训练</button>
  </view>
</view>
