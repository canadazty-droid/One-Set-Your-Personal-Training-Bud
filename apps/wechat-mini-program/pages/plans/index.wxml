<view class="page">
  <text class="eyebrow">PLAN</text>
  <view class="title">计划</view>
  <view class="segmented">
    <button class="{{mode === 'plans' ? 'active' : ''}}" data-mode="plans" bindtap="setMode">我的计划</button>
    <button class="{{mode === 'import' ? 'active' : ''}}" data-mode="import" bindtap="setMode">导入计划</button>
    <button class="{{mode === 'log' ? 'active' : ''}}" data-mode="log" bindtap="setMode">一句话记录</button>
  </view>
  <view wx:if="{{message}}" class="status" style="margin-top:18rpx;">{{message}}</view>

  <block wx:if="{{mode === 'plans'}}">
    <view class="section-title section">本周计划</view>
    <view wx:if="{{!plans.length}}" class="card"><view style="font-weight:800;">还没有保存的计划</view><view class="muted" style="margin-top:10rpx; font-size:26rpx;">粘贴任何教练或 AI 生成的训练文字，ONE SET 会把它变成可执行训练。</view></view>
    <view wx:for="{{plans}}" wx:key="id" class="card">
      <view class="row between"><view><view style="font-weight:850; font-size:34rpx;">{{item.name}}</view><view class="muted" style="font-size:25rpx; margin-top:8rpx;">{{item.exercises.length}} 个动作 · 已结构化</view></view><button class="quiet start-small" data-id="{{item.id}}" bindtap="startPlan">开练</button></view>
    </view>
  </block>

  <block wx:elif="{{mode === 'import'}}">
    <view class="section-title section">导入训练计划</view>
    <view class="subtitle">支持 ChatGPT、DeepSeek、教练或普通文本；V1 使用稳定的规则解析，不调用 LLM。</view>
    <textarea class="textarea" style="margin-top:20rpx;" value="{{importText}}" bindinput="onImportInput" placeholder="例如：卧推4×8，上斜哑铃3×10，飞鸟3×12" />
    <button class="primary" style="margin-top:18rpx;" bindtap="parsePlan">解析计划</button>
    <view wx:if="{{planPreview}}" class="card">
      <view class="row between"><view class="section-title">确认计划</view><text class="muted" style="font-size:24rpx;">置信度 {{planPreview.confidence}}</text></view>
      <view wx:for="{{planPreview.exercises}}" wx:key="exerciseId" class="preview-row"><view><view style="font-weight:800;">{{item.name}}</view><view wx:if="{{item.confidence === 'low'}}" class="danger" style="font-size:22rpx;">请确认动作名称</view></view><text>{{item.sets}} × {{item.repsMin}}{{item.repsMax !== item.repsMin ? '-' + item.repsMax : ''}}</text></view>
      <view wx:for="{{planPreview.warnings}}" wx:key="*this" class="status danger" style="margin-top:12rpx;">{{item}}</view>
      <button class="secondary" style="margin-top:20rpx;" disabled="{{!planPreview.exercises.length || saving}}" bindtap="savePlan">保存到我的计划</button>
    </view>
  </block>

  <block wx:else>
    <view class="section-title section">一句话记录训练</view>
    <view class="subtitle">系统不会猜测缺失数据；识别不清的内容会请你确认。</view>
    <textarea class="textarea" style="margin-top:20rpx;" value="{{logText}}" bindinput="onLogInput" placeholder="卧推80公斤8 8 7，飞鸟20公斤12个三组" />
    <button class="primary" style="margin-top:18rpx;" bindtap="parseLog">识别训练记录</button>
    <view wx:if="{{logPreview}}" class="card">
      <view class="section-title">保存前确认</view>
      <view wx:for="{{logPreview.entries}}" wx:key="exerciseId" class="preview-row"><view><view style="font-weight:800;">{{item.name}}</view><view class="muted" style="font-size:24rpx;">{{item.weightKg}} kg</view></view><text>{{item.repsLabel}}</text></view>
      <view wx:for="{{logPreview.warnings}}" wx:key="*this" class="status danger" style="margin-top:12rpx;">{{item}}</view>
      <button class="secondary" style="margin-top:20rpx;" disabled="{{!logPreview.entries.length || saving}}" bindtap="confirmLog">确认并保存</button>
    </view>
  </block>
</view>
